#!/usr/bin/env bash
set -euo pipefail
packages=(mcp evdev hypothesis pillow pytesseract)
revision="$(printf '%s' "${packages[*]}" | cksum | cut -d' ' -f1)"
environment="${XDG_CACHE_HOME:-$HOME/.cache}/crimson-desert-agent/python-$revision"
if [[ ! -x "$environment/bin/python" ]]; then
  mkdir -p "$(dirname "$environment")"
  if command -v nix >/dev/null; then
    nix_packages="$(printf 'packages.%s ' "${packages[@]}")"
    nix build --impure -o "$environment" --expr \
      "(import (builtins.getFlake \"nixpkgs\") {}).python3.withPackages (packages: [ $nix_packages ])" >&2
  else
    python3 -m venv "$environment" >&2
    "$environment/bin/pip" install --quiet "${packages[@]}" >&2
  fi
fi
echo "$environment/bin/python"
